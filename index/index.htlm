```html
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moto Himalayan 410 Royal Enfield à saisir</title>

<style>
body{
    margin:0;
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f2ec;
    color:#222;
    line-height:1.6;
}

header{
    background:#1f2933;
    color:white;
    text-align:center;
    padding:60px 20px;
}

header h1{
    margin:0;
    font-size:2.8rem;
}

header p{
    font-size:1.4rem;
    margin-top:15px;
    color:#e5e7eb;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:30px 20px;
}

.hero{
    display:grid;
    grid-template-columns:1.2fr 1fr;
    gap:30px;
    align-items:center;
}

.hero img{
    width:100%;
    border-radius:16px;
    box-shadow:0 8px 24px rgba(0,0,0,.18);
}

.card{
    background:white;
    padding:24px;
    border-radius:16px;
    box-shadow:0 4px 16px rgba(0,0,0,.08);
}

.price{
    font-size:2.2rem;
    font-weight:bold;
    color:#c2410c;
    margin:15px 0;
}

.badge{
    display:inline-block;
    background:#e6f4ea;
    color:#137333;
    padding:8px 12px;
    border-radius:999px;
    font-weight:bold;
    margin:5px;
}

.banner{
    background:#137333;
    color:white;
    padding:14px;
    border-radius:12px;
    text-align:center;
    font-weight:bold;
    margin:25px 0;
}

.buttons{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:25px;
}

.btn{
    display:inline-block;
    padding:14px 18px;
    border-radius:10px;
    text-decoration:none;
    font-weight:bold;
    transition:0.2s;
    cursor:pointer;
    border:none;
}

.btn:hover{
    opacity:0.9;
}

.btn.primary{
    background:#c2410c;
    color:white;
}

.btn.secondary{
    background:#374151;
    color:white;
}

.section-title{
    margin-top:50px;
    margin-bottom:20px;
    font-size:2rem;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:16px;
}

.spec{
    background:white;
    padding:18px;
    border-radius:14px;
    box-shadow:0 4px 12px rgba(0,0,0,.05);
}

.spec strong{
    display:block;
    color:#666;
    margin-bottom:6px;
}

.photos{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:15px;
}

.photos img{
    width:100%;
    height:220px;
    object-fit:cover;
    border-radius:12px;
    transition:0.3s;
    cursor:pointer;
}

.photos img:hover{
    transform:scale(1.02);
}

.timeline{
    display:grid;
    gap:14px;
}

.timeline-item{
    background:white;
    padding:18px;
    border-left:5px solid #c2410c;
    border-radius:10px;
    box-shadow:0 4px 12px rgba(0,0,0,.05);
}

.calendly-box{
    margin-top:25px;
    border-radius:16px;
    overflow:hidden;
    background:white;
    box-shadow:0 4px 16px rgba(0,0,0,.08);
}

.cta{
    margin-top:40px;
    text-align:center;
    background:white;
    padding:40px;
    border-radius:16px;
    box-shadow:0 4px 16px rgba(0,0,0,.08);
}

.counter{
    margin-top:20px;
    color:#666;
    font-size:.95rem;
}

footer{
    margin-top:50px;
    padding:30px;
    text-align:center;
    color:#666;
}

/* Lightbox */
.lightbox{
    display:none;
    position:fixed;
    z-index:9999;
    inset:0;
    background:rgba(0,0,0,.92);
    align-items:center;
    justify-content:center;
    flex-direction:column;
}

.lightbox img{
    max-width:90%;
    max-height:80vh;
    border-radius:12px;
}

.lightbox-controls{
    margin-top:18px;
    display:flex;
    gap:12px;
}

.lightbox button{
    background:white;
    color:#111;
    border:none;
    padding:12px 16px;
    border-radius:8px;
    font-weight:bold;
    cursor:pointer;
}

.close{
    position:absolute;
    top:20px;
    right:30px;
    color:white;
    font-size:40px;
    cursor:pointer;
}

@media(max-width:800px){
    .hero{
        grid-template-columns:1fr;
    }

    header h1{
        font-size:2rem;
    }

    header p{
        font-size:1.1rem;
    }
}
</style>
</head>

<body>

<header>
    <h1><strong>Moto Himalayan 410 Royal Enfield à saisir</strong></h1>
    <p>Faible kilométrage, entretenue et prête à rouler</p>

    <div style="margin-top:25px;">
        <a class="btn primary" href="#reservation">📅 Réserver une visite</a>
    </div>
</header>

<main class="container">

    <div class="banner">
        ✅ Contrôle technique favorable — Rapport Histovec et certificat administratif disponibles
    </div>

    <section class="hero">
        <img src="photos/1.jpeg" alt="Royal Enfield Himalayan 410" onclick="openLightbox(0)">

        <div class="card">
            <h2>Royal Enfield Himalayan 410</h2>

            <div class="price">3 700 €</div>

            <span class="badge">411 cm³</span>
            <span class="badge">Permis A2</span>
            <span class="badge">2 places</span>
            <span class="badge">Contrôle technique OK</span>
            <span class="badge">Histovec disponible</span>

            <p>
                Moto robuste, fiable et économique. Idéale pour les trajets quotidiens,
                les balades ou le voyage. Faible kilométrage et entretien suivi.
            </p>

            <div class="buttons">
                <a class="btn primary" href="#reservation">📅 Prendre rendez-vous</a>
                <a class="btn secondary" href="#galerie">📸 Voir les photos</a>
                <a class="btn secondary" href="Entretien_.pdf" target="_blank">🔧 Voir l'entretien</a>
                <a class="btn secondary" href="rapport_histovec.pdf" target="_blank">📄 Rapport Histovec</a>
                <a class="btn secondary" href="certificatdesituationadministrative.pdf" target="_blank">✅ Certificat administratif</a>
                <a class="btn secondary" href="mailto:pascal.azema@gmail.com?subject=Royal Enfield Himalayan 410">✉️ Contacter le vendeur</a>
            </div>

            <div class="counter">
                Cette page a été consultée <span id="viewCount">0</span> fois sur ce navigateur.
            </div>
        </div>
    </section>

    <h2 class="section-title">Caractéristiques</h2>

    <div class="grid">
        <div class="spec"><strong>Marque</strong>Royal Enfield</div>
        <div class="spec"><strong>Modèle</strong>Himalayan 410</div>
        <div class="spec"><strong>Première mise en circulation</strong>Mars 2020</div>
        <div class="spec"><strong>Kilométrage connu</strong>3 636 km au 26/06/2025</div>
        <div class="spec"><strong>Cylindrée</strong>411 cm³</div>
        <div class="spec"><strong>Puissance</strong>18 kW - 5 CV</div>
        <div class="spec"><strong>Places</strong>2</div>
        <div class="spec"><strong>Couleur</strong>Gris foncé</div>
        <div class="spec"><strong>Situation</strong>Non gagée et apte à circuler</div>
    </div>

    <h2 class="section-title">Pourquoi cette moto ?</h2>

    <div class="card">
        <ul>
            <li>Faible kilométrage</li>
            <li>Contrôle technique favorable</li>
            <li>Entretien documenté</li>
            <li>Rapport Histovec disponible</li>
            <li>Certificat administratif fourni</li>
            <li>Moto prête à prendre la route immédiatement</li>
        </ul>
    </div>

    <h2 class="section-title">Historique d'entretien</h2>

    <div class="timeline">
        <div class="timeline-item">
            <strong>17/03/2023 — Préparation VO</strong><br>
            Vidange moteur, filtre à huile, joint de vidange, tension et graissage de chaîne,
            batterie, circuit de charge, garde d’embrayage, contrôle général et essai routier.
        </div>

        <div class="timeline-item">
            <strong>17/06/2025 — Contrôle technique</strong><br>
            Contrôle technique réalisé avec kilométrage relevé à 3 628 km.
        </div>

        <div class="timeline-item">
            <strong>19/06/2025 — Intervention pneu</strong><br>
            Montage pneu avant/arrière et recyclage pneus.
        </div>

        <div class="timeline-item">
            <strong>26/06/2025 — Contrôle technique favorable</strong><br>
            Contrôle technique favorable avec kilométrage connu à 3 636 km.
        </div>
    </div>

    <h2 class="section-title" id="galerie">Galerie photos</h2>
    <p>Cliquez sur une photo pour l’ouvrir en plein écran.</p>

    <div class="photos">
        <img src="photos/1.jpeg" onclick="openLightbox(0)" alt="Photo 1">
        <img src="photos/2.jpeg" onclick="openLightbox(1)" alt="Photo 2">
        <img src="photos/3.jpg" onclick="openLightbox(2)" alt="Photo 3">
        <img src="photos/4.jpg" onclick="openLightbox(3)" alt="Photo 4">
        <img src="photos/5.jpg" onclick="openLightbox(4)" alt="Photo 5">
        <img src="photos/6.jpg" onclick="openLightbox(5)" alt="Photo 6">
        <img src="photos/7.jpg" onclick="openLightbox(6)" alt="Photo 7">
        <img src="photos/8.jpeg" onclick="openLightbox(7)" alt="Photo 8">
        <img src="photos/9.jpg" onclick="openLightbox(8)" alt="Photo 9">
        <img src="photos/10.jpg" onclick="openLightbox(9)" alt="Photo 10">
        <img src="photos/11.jpg" onclick="openLightbox(10)" alt="Photo 11">
        <img src="photos/12.jpeg" onclick="openLightbox(11)" alt="Photo 12">
        <img src="photos/13.jpeg" onclick="openLightbox(12)" alt="Photo 13">
    </div>

    <h2 class="section-title" id="reservation">Réserver une visite</h2>

    <div class="card">
        <p>
            Choisissez directement un créneau disponible pour voir la moto.
        </p>

        <div class="calendly-box">
            <iframe
                src="https://calendly.com/pascal-azema-3_xy/visite_moto"
                width="100%"
                height="750"
                frameborder="0">
            </iframe>
        </div>
    </div>

    <div class="cta">
        <h2>Intéressé par la moto ?</h2>
        <p>Le plus simple est de réserver un créneau de visite.</p>

        <a class="btn primary" href="#reservation">
            📅 Réserver une visite
        </a>

        <a class="btn secondary" href="mailto:pascal.azema@gmail.com?subject=Royal Enfield Himalayan 410">
            ✉️ Contacter le vendeur
        </a>
    </div>

</main>

<footer>
    Royal Enfield Himalayan 410 • Vente entre particuliers • Dossier complet disponible
</footer>

<div class="lightbox" id="lightbox">
    <span class="close" onclick="closeLightbox()">×</span>
    <img id="lightbox-img" src="" alt="Photo moto">
    <div class="lightbox-controls">
        <button onclick="prevImage()">← Précédente</button>
        <button onclick="nextImage()">Suivante →</button>
    </div>
</div>

<script>
const images = [
    "photos/1.jpeg",
    "photos/2.jpeg",
    "photos/3.jpg",
    "photos/4.jpg",
    "photos/5.jpg",
    "photos/6.jpg",
    "photos/7.jpg",
    "photos/8.jpeg",
    "photos/9.jpg",
    "photos/10.jpg",
    "photos/11.jpg",
    "photos/12.jpeg",
    "photos/13.jpeg"
];

let currentImage = 0;

function openLightbox(index){
    currentImage = index;
    document.getElementById("lightbox-img").src = images[currentImage];
    document.getElementById("lightbox").style.display = "flex";
}

function closeLightbox(){
    document.getElementById("lightbox").style.display = "none";
}

function nextImage(){
    currentImage = (currentImage + 1) % images.length;
    document.getElementById("lightbox-img").src = images[currentImage];
}

function prevImage(){
    currentImage = (currentImage - 1 + images.length) % images.length;
    document.getElementById("lightbox-img").src = images[currentImage];
}

document.addEventListener("keydown", function(event){
    if(event.key === "Escape") closeLightbox();
    if(event.key === "ArrowRight") nextImage();
    if(event.key === "ArrowLeft") prevImage();
});

let views = localStorage.getItem("motoPageViews");
views = views ? parseInt(views) + 1 : 1;
localStorage.setItem("motoPageViews", views);
document.getElementById("viewCount").textContent = views;
</script>

</body>
</html>
```
